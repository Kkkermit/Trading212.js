# Copy to .env and fill in. Never commit .env.
# Keys are made in the Trading 212 app: Settings > API (Beta). A key belongs to one environment.
T212_ENV=demo
T212_API_KEY=
T212_API_SECRET=

# Optional: keep a key per environment and switch with T212_ENV.
T212_DEMO_API_KEY=
T212_DEMO_API_SECRET=
T212_LIVE_API_KEY=
T212_LIVE_API_SECRET=
